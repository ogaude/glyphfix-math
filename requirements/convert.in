# Conversion env (.venv-convert) for llama.cpp convert_hf_to_gguf.py. Separate from .venv-lighton.
# Direct requirements follow the pinned llama.cpp checkout (requirements-convert_hf_to_gguf.txt and the
# legacy file it includes), except transformers (the training pin, tried first) and torch (CPU wheel).
# gguf comes from the checkout's own gguf-py (installed by scripts/spikes/setup_convert_env.sh), whose
# runtime deps (tqdm, pyyaml, requests) are listed here because it is installed with --no-deps.
# Recompile: uv pip compile requirements/convert.in -o requirements/convert.lock.txt --python-version 3.12 \
#   --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu \
#   --index-strategy unsafe-best-match --emit-index-annotation --generate-hashes
torch==2.14.1+cpu
transformers==5.19.0
numpy~=2.2.6
sentencepiece>=0.1.98,<0.3.0
protobuf>=4.21.0,<5.0.0
safetensors==0.8.0
tqdm>=4.27
pyyaml>=5.1
requests>=2.25
